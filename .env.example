# resource server (NO Hedera key — server signs nothing)
HEDERA_NETWORK=hedera:testnet
FACILITATOR_URL=https://api.testnet.blocky402.com
PAY_TO_ACCOUNT=0.0.xxxx
DATA_PROVIDER=zacca-decentralized
PORT=4021
# comma-separated origins allowed to call this API from a browser (frontend/)
CORS_ORIGIN=https://pay.zacca.ai,http://localhost:5173

# on-chain client (src/chain) -- reads VBR/Statement/DCS registries + CreditLine,
# and writes DCS attestations (Zacca acting as attestor, plan §6.5 Stage 2).
# HEDERA_TESTNET_DEPLOYER_KEY is an ECDSA (secp256k1) key -- NOT the ED25519
# HEDERA_CLIENT_KEY below; see contracts/README.md for why. Same key used to
# deploy the contracts in contracts/.
HEDERA_JSON_RPC_URL=https://testnet.hashio.io/api
HEDERA_TESTNET_DEPLOYER_KEY=

# client script (scripts/e2e-pay.ts) — the only secret in the project
HEDERA_CLIENT_ID=0.0.yyyy
HEDERA_CLIENT_KEY=
SERVER_URL=http://localhost:4021
E2E_PRODUCT=dcs-score
E2E_SYMBOL=biz-alice-mboga
