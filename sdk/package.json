{
  "name": "@zacca/sdk",
  "version": "0.1.0",
  "description": "SDK for stablecoin wallets, BNPL checkouts, and lending protocols to integrate Zacca's Credit Intelligence API (x402 on Hedera).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "@x402/core": "2.19.0",
    "@x402/fetch": "2.19.0",
    "@x402/hedera": "2.19.0",
    "ethers": "^6.17.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
